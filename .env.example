# Copier en .env (jamais versionné) puis renseigner.
# Tous les secrets sont vides exprès : docker-compose refuse de démarrer tant qu'ils ne sont pas renseignés.
DATABASE_PASSWORD=
# 32 caractères minimum, généré : openssl rand -base64 48  (une valeur d'exemple est refusée en production)
REVIA_JWT_SECRET=
REVIA_ADMIN_EMAIL=admin@revia.local
# 8 caractères minimum, au moins une lettre et un chiffre
REVIA_ADMIN_PASSWORD=
# Fournisseur principal : gemini | groq | openrouter | mistral | ollama (gratuits) · openai | anthropic (payants) · demo (sans LLM)
REVIA_AI_PROVIDER=gemini
# vide = modèle par défaut : gemini-flash-latest / openai/gpt-oss-120b (Groq) / openrouter/free (OpenRouter)
#                            / codestral-latest (Mistral) / qwen2.5-coder:1.5b (Ollama)
REVIA_AI_MODEL=
# Clé du fournisseur principal (ou laissez vide et renseignez sa clé propre ci-dessous)
REVIA_AI_API_KEY=
# Relais automatique quand un quota gratuit est atteint (les fournisseurs sans clé sont ignorés ; demo = dernier recours)
REVIA_AI_FALLBACK=groq,openrouter,mistral,demo
# Clés gratuites : aistudio.google.com · console.groq.com · openrouter.ai/keys · console.mistral.ai
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
REVIA_CORS_ORIGINS=http://localhost:8080
# Langue des rapports IA : classpath:prompts/revue-system.st (FR) ou classpath:prompts/revue-system.en.st (EN)
REVIA_PROMPT=
# Essai gratuit sans compte sur la page d'accueil (rien n'est enregistré)
REVIA_ESSAI_ACTIF=true
REVIA_ESSAI_MAX_LIGNES=150
REVIA_ESSAI_MINUTE=3
REVIA_ESSAI_JOUR=300
# Derrière Vercel : x-vercel-forwarded-for (vraie IP du visiteur pour la limitation de débit)
REVIA_IP_HEADER=
# Outils IA (tests, plans de test) : budget de jetons et délai
REVIA_AI_MAX_TOKENS_OUTILS=16384
REVIA_AI_TIMEOUT_OUTILS=180
# GitHub App « installer RevIA en un clic » (docs/GITHUB-APP.md) : désactivée tant que les 4 premières sont vides
GITHUB_APP_ID=
# Clé privée PEM de l'application, sur une ligne avec des \n littéraux (ou multiligne entre guillemets)
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
# Facultatif : GitHub Enterprise Server (https://<hôte>/api/v3) ; défaut https://api.github.com
GITHUB_API_URL=
# Facultatif : vérification OAuth de l'accès de l'utilisateur lors de la liaison d'une installation
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
