# Copier en .env (jamais versionné) puis renseigner.
DATABASE_PASSWORD=changez-moi
# 32 caractères minimum (ex. : openssl rand -base64 48)
REVIA_JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire-de-48-caracteres
REVIA_ADMIN_EMAIL=admin@revia.local
REVIA_ADMIN_PASSWORD=ChangezMoi2026!
# groq | gemini | ollama (gratuits) · openai | anthropic (payants) · demo (sans LLM)
REVIA_AI_PROVIDER=gemini
# vide = modèle par défaut (llama-3.3-70b-versatile / gemini-flash-lite-latest / qwen2.5-coder:1.5b ...)
REVIA_AI_MODEL=
REVIA_AI_API_KEY=
REVIA_CORS_ORIGINS=http://localhost:8080
